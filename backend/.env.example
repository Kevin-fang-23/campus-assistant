# 复制为 .env 后按需修改。所有值都有默认值，开箱即用（无需任何 Key）。

# ---- 应用 ----
APP_NAME=校园事务智能助手
DEBUG=true

# 数据库：开发默认 SQLite（自动创建 campus.db）。
# 生产可改为 PostgreSQL：postgresql+psycopg://user:pwd@host:5432/campus
DATABASE_URL=sqlite:///./campus.db
# SQLite 并发写需要该参数，PostgreSQL 下可删掉
# SQLITE_CHECK_SAME_THREAD=false

# 上传/解析文件存储目录
STORAGE_DIR=./storage

# ---- 视觉大模型 / LLM ----
# mock：内置规则实现，无需 Key，全链路可跑通
# dashscope：阿里云百炼 OpenAI 兼容接口（qwen3-vl-plus / qwen3.5-vl-plus 等）
VLM_PROVIDER=mock
VLM_MODEL=qwen3-vl-plus
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
VLM_TIMEOUT=60
VLM_MAX_RETRIES=2

# ---- OCR ----
# auto：paddleocr -> rapidocr -> vlm -> stub 自动探测
OCR_PROVIDER=auto
OCR_LANG=ch
PDF_OCR_DPI=180
PDF_TEXT_MIN_CHARS=20

# ---- 向量检索 ----
# auto：有 DASHSCOPE_API_KEY 用 dashscope 向量，否则本地哈希向量（零依赖）
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=256
# 余弦相似度高于该值判定为重复通知
DEDUP_THRESHOLD=0.90
SEARCH_TOP_K=5

# ---- 混合检索（向量 + BM25，加权 RRF 融合）----
# 关掉即退回纯向量（与加 BM25 之前行为一致，可随时回滚）
HYBRID_ENABLED=true
# RRF 平滑常数（来自原论文，一般不必改）：越大，靠前名次的优势越平缓
HYBRID_RRF_K=60
# 两路权重，和为 1；当前值是评测扫出来的（见 eval/）
HYBRID_WEIGHT_VECTOR=0.1
HYBRID_WEIGHT_BM25=0.9
# 融合前的候选池大小：多召回一些，才有机会把"向量排 12 但 BM25 排 2"的文档顶上来
HYBRID_FETCH_K=20
# BM25 参数：k1 控制词频饱和，b 控制长度归一化强度
BM25_K1=1.5
BM25_B=0.75

# ---- 相关性阈值（决定是否提示「未找到相关内容」）----
# 判据 =「查询与候选文档共享的**二字及以上词**个数」≥ 该值，才算相关。
#
# 为什么不用分数做阈值：BM25 绝对分 / 余弦 / 句级选片分三种判据实测**区间全部重叠**
#（噪声查询的最高分 ≥ 真实查询的最低分），因为中文里单字重合必然发生
#（"今天天气"会撞"明天"里的"天"）。改用二字词重合计数即可分开。
#
# 取 1 而非 2 的理由（实测 129 条真实查询 / 2 条无答案查询）：
#   T=1 → 拦下 1/2 噪声，误杀 0/129 真实查询   ← 当前值，零成本
#   T=2 → 拦下 2/2 噪声，但误杀 9/129
#   T=3 → 拦下 2/2 噪声，但误杀 23/129
# 设为 0 可完全关闭该判定（退回「恒返回 top-k」的旧行为）。
SEARCH_MIN_BIGRAM_OVERLAP=1
# 灰度观察模式：true 时只标记不丢弃（filtered=true 但结果照常返回），
# 便于在生产上看阈值会拦掉什么，再决定是否真正启用。
SEARCH_KEEP_IF_FILTERED=false

# ---- 待办生成 ----
# 截止前多少小时提醒
REMIND_LEAD_HOURS=24
# 抽取置信度低于该值进入人工复核
REVIEW_CONFIDENCE_THRESHOLD=0.55

# ---- CORS（前端开发地址）----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
