# ============================================================
# 校园多模态事务智能助手 — 环境变量模板（不含真实密钥，随仓库分发）
#
# 用法：复制为 .env 后按需修改，.env 已被 .gitignore 排除，不会入库。
#   cp .env.example .env        # macOS / Linux
#   copy .env.example .env      # Windows
#
# 所有项都有代码内置默认值，不建 .env 也能全链路跑通（VLM 走 mock 规则）。
# 加载优先级：backend/.env  <  项目根 .env  <  系统环境变量
# ============================================================


# ---------------- 应用 ----------------
# 演示/生产务必 false：true 时异常返回完整堆栈，公网会暴露路径与依赖版本
APP_NAME=校园事务智能助手
DEBUG=false


# ---------------- 数据库 ----------------
# 留空 = 使用代码内置绝对路径默认值（backend/campus.db），不受启动目录影响。
# 显式指定时路径相对「启动目录」解析（start.bat 在 backend/ 下启动）：
# DATABASE_URL=sqlite:///./campus.db
# 生产切 PostgreSQL（需 pip install psycopg[binary]）：
# DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus

# 上传/解析文件落盘目录（相对启动目录）
STORAGE_DIR=./storage


# ---------------- 视觉大模型 / LLM ----------------
# mock      = 内置规则实现，无需 Key（默认，全链路可跑通）
# dashscope = 阿里云百炼 OpenAI 兼容接口
#
# 免费额度：实名认证后自动到账，每款模型各 100 万 tokens，有效期 90 天，无需充值。
# 获取：阿里云控制台 -> 百炼 -> API-Key 管理（密钥以 sk- 开头，仅显示一次）
# 建议同时开启「免费额度用完即停」，避免额度耗尽后自动转按量付费。
VLM_PROVIDER=mock
VLM_MODEL=qwen3-vl-plus
# 华北2（北京）；新加坡地域为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ⚠️ 真实密钥只填在 .env 里，切勿提交到仓库、切勿贴进聊天或 issue。
# 两个变量名等价：ALIYUN_API_KEY 为主，DASHSCOPE_API_KEY 为历史别名，任一有值即生效。
ALIYUN_API_KEY=
DASHSCOPE_API_KEY=
# 单次调用超时（秒）
VLM_TIMEOUT=60
# 可重试错误（429/5xx/网络）的最大重试次数；4xx 鉴权与参数错误不重试
VLM_MAX_RETRIES=2
# 退避：第 n 次等待 = min(VLM_BACKOFF_MAX, VLM_BACKOFF_BASE * 2**n) * 抖动
VLM_BACKOFF_BASE=0.8
VLM_BACKOFF_MAX=8.0


# ---------------- 检索增强问答（/api/qa） ----------------
# QA_PROVIDER: auto = 有 API Key 走 LLM 生成，无 Key 自动降级为抽取式回答
#              mock = 强制降级（演示 / 离线 / 测试用）
# QA_MODEL:   纯文本对话模型，无需视觉能力；默认值 qwen-plus 比 qwen3-vl-plus 便宜且更快
QA_PROVIDER=auto
QA_MODEL=qwen-plus


# ---------------- 请求限流 ----------------
# 目的：演示链接公网可见时，保护百炼额度不被脚本刷干、保护单进程不被打挂。
# 三层策略（任一超限即返回 429）：
#   L1 每 IP 每分钟 —— 令牌桶，允许小突发，拦瞬时洪峰
#   L2 每 IP 每日   —— 拦单源长时间慢刷，避免它吃光全局额度
#   L3 全局每日     —— 总支出上限（真正的资金护栏，跨 IP 生效）
# 数值为 0 表示该层不启用。改动即生效，无需改代码。
# 关于信任代理：置 ngrok / Nginx 之后必须设为 true，
#   否则所有访客会被视作同一来源（源地址恒为代理地址）；
#   直连公网时必须保持 false，否则访客可伪造 X-Forwarded-For 绕过限流。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false

# 成本端点 /api/qa（每次请求 = 1 次 LLM + 1 次 embedding）
RATE_LIMIT_QA_PER_MIN=6
RATE_LIMIT_QA_PER_IP_DAY=60
RATE_LIMIT_QA_PER_DAY=300

# 成本端点 /api/documents/*（每次请求 = VLM + OCR 解析）
RATE_LIMIT_INGEST_PER_MIN=10
RATE_LIMIT_INGEST_PER_IP_DAY=40
RATE_LIMIT_INGEST_PER_DAY=200

# 其余 /api/* 只读接口（不花钱，仅防高频锤击）
RATE_LIMIT_DEFAULT_PER_MIN=120


# ---------------- OCR ----------------
# auto       = paddleocr -> rapidocr -> vlm -> stub 依次探测
# rapid      = 固定用 RapidOCR（已安装时推荐，省去启动探测）
# paddle / vlm / stub = 强制指定
OCR_PROVIDER=auto
OCR_LANG=ch
PDF_OCR_DPI=180
PDF_TEXT_MIN_CHARS=20


# ---------------- 向量检索 / 去重 ----------------
# auto = 有 DASHSCOPE_API_KEY 时走 dashscope，否则回退 local_hash
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=256
DEDUP_THRESHOLD=0.90
SEARCH_TOP_K=5


# ---------------- 待办生成 / 人工复核 ----------------
REMIND_LEAD_HOURS=24
REVIEW_CONFIDENCE_THRESHOLD=0.55


# ---------------- CORS ----------------
# 支持 JSON 数组，也支持逗号分隔字符串
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]
