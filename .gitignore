# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
env/
*.db
backend/campus.db
# SQLite WAL 模式的副产物（开启 WAL 后自动生成）。
# 限流的日计数表会长期持有数据库连接，WAL 文件始终存在；
# 它们与 .db 一样是本地运行时状态，不入库。
*.db-shm
*.db-wal
backend/storage/
.env
.env.*
!.env.example

# ---- 密钥与证书（绝不入库） ----
*.key
*.pem
*.p12
secrets.*
*credentials*.json
.aliyun/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
npm-debug.log*
yarn-error.log*

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 本地运行状态 ----
.campus_ports

# ---- 工具产物 / 不该进仓库的辅助文件 ----
.workbuddy/
.trae-html-share-packages/
campus-assistant-review/

# ---- 个人文档（简历等）绝不入库 ----
*.docx
*.doc
*.pdf
resume*
简历*
!README*
